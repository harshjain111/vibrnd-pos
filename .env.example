# Vibrnd POS — required env vars.
#
# The Vercel Storage → Supabase integration writes these in different
# names (POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING).
# After the integration runs, add DATABASE_URL + DIRECT_URL as aliases
# pointing at those, OR paste the Supabase pooler / direct URLs here.

# Pooler URL — port 6543, transaction mode. Prisma runtime uses this.
# From Supabase: Settings → Database → Connection string → URI (transaction pooler).
DATABASE_URL="postgresql://postgres.<project>:<pw>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct URL — port 5432, session mode. Prisma migrate deploy uses this.
# From Supabase: Settings → Database → Connection string → URI (direct connection).
DIRECT_URL="postgresql://postgres.<project>:<pw>@aws-<region>.pooler.supabase.com:5432/postgres"

# Auth cookie signing secret — 32+ random chars. Change this before prod.
AUTH_SECRET="change-me-to-a-32-character-random-string"

# Node runtime hint — Vercel sets this automatically. Local dev picks it
# up from .env.local if you keep it there.
NODE_ENV="development"
